---
import Icon from './Icon.astro';
import { site, pick, activeSocials } from '../lib/content';
import { t, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const messages = {
  sending: t(lang, 'contact.sending'),
  ok: t(lang, 'contact.success'),
  err: t(lang, 'contact.error'),
  none: t(lang, 'contact.noEndpoint'),
  mailto: t(lang, 'contact.mailto'),
};
---

<section class="section" id="contact">
  <div class="container">
    <div class="contact__grid">
      <div data-reveal>
        <span class="eyebrow">{t(lang, 'contact.eyebrow')}</span>
        <h2 class="contact__title">
          {t(lang, 'contact.title')}
        </h2>
        <p class="contact__lead">{t(lang, 'contact.lead')}</p>

        {
          site.email && (
            <div class="contact__mailrow">
              <a class="contact__mail" href={`mailto:${site.email}`}>
                <Icon name="mail" size={16} />
                {site.email}
              </a>
              <button
                class="icon-btn"
                type="button"
                data-copy={site.email}
                data-copied={t(lang, 'contact.copied')}
                aria-label={t(lang, 'contact.copy')}
                title={t(lang, 'contact.copy')}
              >
                <Icon name="copy" size={16} />
              </button>
            </div>
          )
        }

        {
          activeSocials.length > 0 && (
            <div class="contact__socials">
              {activeSocials.map((social) => (
                <a
                  class="icon-btn"
                  href={social.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={social.label}
                  title={social.label}
                >
                  <Icon name={social.icon} size={19} />
                </a>
              ))}
            </div>
          )
        }
      </div>

      <form
        class="form"
        data-reveal
        data-contact-form
        data-endpoint={site.formEndpoint}
        data-email={site.email}
        data-messages={JSON.stringify(messages)}
        action={site.formEndpoint || undefined}
        method="post"
      >
        <label class="field">
          <span class="field__label">{t(lang, 'contact.name')}</span>
          <input class="input" type="text" name="name" required autocomplete="name" placeholder="—" />
        </label>

        <label class="field">
          <span class="field__label">{t(lang, 'contact.email')}</span>
          <input class="input" type="email" name="email" required autocomplete="email" placeholder="you@email.com" dir="ltr" />
        </label>

        <label class="field">
          <span class="field__label">{t(lang, 'contact.message')}</span>
          <textarea class="input" name="message" required rows="5" placeholder="—"></textarea>
        </label>

        <input class="sr-only" type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <div class="form__foot">
          <button class="btn btn--primary" type="submit">
            {t(lang, 'contact.send')}
            <Icon name="arrow-up-right" size={18} />
          </button>
          <p class="form__note">
            {site.email
              ? `${t(lang, 'contact.or')} ${site.email}`
              : t(lang, 'contact.noEndpoint')}
          </p>
        </div>

        <p class="form__status" data-status role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>
