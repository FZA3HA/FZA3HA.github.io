---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Marquee from '../../components/Marquee.astro';
import About from '../../components/About.astro';
import Programs from '../../components/Programs.astro';
import Sites from '../../components/Sites.astro';
import Links from '../../components/Links.astro';
import Skills from '../../components/Skills.astro';
import Contact from '../../components/Contact.astro';
import { site, pick } from '../../lib/content';

const lang = 'en' as const;
const title = `${site.brand} — ${pick(site.name, 'en')} | ${pick(site.role, 'en')}`;
const description = pick(site.tagline, 'en');
const marquee = [...site.focus, 'Python', 'FastAPI', 'Astro', 'Automation', 'CLI'];
---

<BaseLayout lang={lang} title={title} description={description}>
  <Hero lang={lang} />
  <Marquee items={marquee} />
  <About lang={lang} />
  <Programs lang={lang} />
  <Sites lang={lang} />
  <Links lang={lang} />
  <Skills lang={lang} />
  <Contact lang={lang} />
</BaseLayout>
